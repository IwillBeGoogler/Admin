{
  "name": "iwillbegoogler-admin-react",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "tsr generate && tsc --noEmit && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "gen:api": "bun scripts/gen-api.ts",
    "routes": "tsr generate"
  },
  "dependencies": {
